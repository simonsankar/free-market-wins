---
---

<div
  id="link-preview"
  class="fixed z-[200] w-[min(24rem,calc(100vw-24px))] rounded-[24px] border border-parchment bg-bone p-5"
  hidden
>
  <p class="link-preview-kind mono-label m-0 mb-2 empty:hidden"></p>
  <p class="link-preview-title display-sm m-0 mb-2 !text-[1.0625rem] !leading-tight"></p>
  <p class="link-preview-excerpt m-0 text-[0.875rem] leading-normal text-char"></p>
</div>

<script>
  const popover = document.getElementById("link-preview")
  const titleEl = popover.querySelector(".link-preview-title")
  const excerptEl = popover.querySelector(".link-preview-excerpt")
  const kindEl = popover.querySelector(".link-preview-kind")

  let showTimer = null
  let hideTimer = null
  let activeLink = null

  function position(link) {
    const rect = link.getBoundingClientRect()
    const popRect = popover.getBoundingClientRect()
    let left = rect.left
    let top = rect.bottom + 8
    if (left + popRect.width > window.innerWidth - 12) {
      left = window.innerWidth - popRect.width - 12
    }
    if (top + popRect.height > window.innerHeight - 12) {
      top = rect.top - popRect.height - 8
    }
    popover.style.left = `${Math.max(12, left)}px`
    popover.style.top = `${Math.max(12, top)}px`
  }

  function show(link) {
    activeLink = link
    titleEl.textContent = link.dataset.previewTitle
    kindEl.textContent = link.dataset.previewKind || ""
    excerptEl.textContent = link.dataset.previewExcerpt || ""
    popover.hidden = false
    position(link)
  }

  function hide() {
    popover.hidden = true
    activeLink = null
  }

  document.addEventListener("mouseover", (ev) => {
    const link = ev.target.closest?.("a.internal[data-preview-title]")
    if (!link) return
    clearTimeout(hideTimer)
    clearTimeout(showTimer)
    showTimer = setTimeout(() => show(link), 200)
  })

  document.addEventListener("mouseout", (ev) => {
    const link = ev.target.closest?.("a.internal[data-preview-title]")
    if (!link) return
    clearTimeout(showTimer)
    hideTimer = setTimeout(hide, 150)
  })

  popover.addEventListener("mouseenter", () => clearTimeout(hideTimer))
  popover.addEventListener("mouseleave", () => {
    hideTimer = setTimeout(hide, 100)
  })

  window.addEventListener("scroll", () => {
    if (activeLink) position(activeLink)
  })
</script>
