---
import Layout from "../../layouts/Layout.astro"
import CanvasView from "../../components/CanvasView.astro"
import { listCanvases, loadCanvas } from "../../lib/canvas.mjs"

export async function getStaticPaths() {
  return listCanvases().map((c) => ({
    params: { slug: c.slug },
    props: { rel: c.rel, title: c.title },
  }))
}

const { rel, title } = Astro.props
const { canvas, attachments, fileUrls } = loadCanvas(rel)
---

<Layout title={title} description={`${title} — visual concept map`}>
  <h1 class="article-title">{title}</h1>
  <p class="mb-6 max-w-[42rem] text-gray">
    A visual concept map from the vault's Obsidian canvas. Click a card to open the note.
  </p>
  <CanvasView id="main" canvas={canvas} attachments={attachments} fileUrls={fileUrls} height={720} />
</Layout>
