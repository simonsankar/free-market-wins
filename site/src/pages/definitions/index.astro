---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"

const entries = (await getCollection("definitions", (e) => e.data.unlisted !== true)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title),
)

const groups = new Map()
for (const entry of entries) {
  const letter = entry.data.title[0]?.toUpperCase() ?? "#"
  if (!groups.has(letter)) groups.set(letter, [])
  groups.get(letter).push(entry)
}
const letters = Array.from(groups.keys()).sort()
---

<Layout title="Definitions" description="A searchable glossary of Austrian economics and libertarian terms.">
  <h1 class="article-title">Definitions</h1>
  <p class="max-w-[42rem] text-gray">
    A glossary of the concepts the essays build on — Austrian economics, natural rights theory,
    and the arguments against central planning.
  </p>

  <div class="relative my-5 max-w-md">
    <svg
      class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    <input
      id="definitions-filter"
      type="text"
      placeholder="Filter definitions…"
      autocomplete="off"
      spellcheck="false"
      class="w-full rounded-[2px] border border-lightgray bg-transparent py-2 pr-3 pl-9 font-body text-sm text-darkgray outline-none placeholder:text-gray focus:border-secondary"
    />
  </div>

  <nav id="definitions-jump" class="mb-6 flex flex-wrap gap-1.5 font-code">
    {
      letters.map((l) => (
        <a
          class="inline-block h-7 w-7 rounded-[2px] border border-lightgray text-center leading-7 text-darkgray no-underline hover:border-secondary hover:text-secondary"
          href={`#${l}`}
        >
          {l}
        </a>
      ))
    }
  </nav>

  <div id="definitions-list">
    {
      letters.map((letter) => (
        <section data-letter-section class="mt-6">
          <h2 id={letter} class="mb-2 font-code text-[0.85rem] tracking-wider text-secondary uppercase">
            {letter}
          </h2>
          <ul class="grid list-none grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-1.5 p-0 m-0">
            {groups.get(letter).map((entry) => (
              <li data-definition-item data-term={entry.data.title.toLowerCase()}>
                <a class="internal list-row block px-3 py-1.5 text-sm" href={`/definitions/${entry.id}/`}>
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p id="definitions-empty" class="mt-6 hidden font-code text-xs text-gray">No definitions match your filter.</p>
</Layout>

<script>
  const input = document.getElementById("definitions-filter") as HTMLInputElement | null
  const sections = document.querySelectorAll<HTMLElement>("#definitions-list [data-letter-section]")
  const empty = document.getElementById("definitions-empty")
  const jump = document.getElementById("definitions-jump")

  input?.addEventListener("input", () => {
    const term = input.value.trim().toLowerCase()
    let anyVisible = false

    sections.forEach((section) => {
      let sectionHasMatch = false
      section.querySelectorAll<HTMLElement>("[data-definition-item]").forEach((item) => {
        const match = !term || (item.dataset.term ?? "").includes(term)
        item.style.display = match ? "" : "none"
        if (match) sectionHasMatch = true
      })
      section.style.display = sectionHasMatch ? "" : "none"
      if (sectionHasMatch) anyVisible = true
    })

    if (jump) jump.style.display = term ? "none" : ""
    if (empty) empty.classList.toggle("hidden", anyVisible)
  })
</script>
