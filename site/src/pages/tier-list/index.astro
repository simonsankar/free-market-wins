---
import fs from "node:fs"
import path from "node:path"
import { getCollection, render } from "astro:content"
import Layout from "../../layouts/Layout.astro"

// Card content lives here rather than as vault markdown/content-collection
// entries — these are throwaway debate one-liners for a ranking toy, not
// doctrine/essays/dissects, so none of the five vault bins in CLAUDE.md fit.
const ARGUMENTS = [
  { id: "might-makes-right", title: "Might Makes Right", blurb: "Without a state's monopoly on force, whoever's strongest just rules." },
  { id: "warlords-problem", title: "Warlords", blurb: "No central state, so the power vacuum fills with competing warlords and mega-corps." },
  { id: "voluntary-slavery", title: "Voluntary Slavery", blurb: "People could sell themselves into permanent bondage via contract." },
  { id: "profits-over-people", title: "Profits Over People", blurb: "Markets replace human concern with cold profit-seeking." },
  { id: "moral-degeneracy", title: "Moral Degeneracy", blurb: "Capitalism makes people greedy, atomized, culturally hollow." },
  { id: "never-been-tried", title: "Never Been Tried", blurb: "No stateless-market society has ever existed (Iceland etc. don't count, apparently)." },
  { id: "free-rider-problem", title: "Free Rider Problem", blurb: "Non-excludable, non-rivalrous goods get under-produced because no one has to pay to benefit." },
  { id: "roads", title: "Muh Roads", blurb: "Who builds and maintains roads without a taxing authority?" },
  { id: "public-utilities", title: "Public Goods", blurb: "Water, power, the internet, etc. are “too essential” or “too foundational” to be run for profit." },
  { id: "poor-people", title: "Poor People", blurb: "Without welfare, poor people starve or go without care." },
  { id: "environment", title: "The Environment", blurb: "No regulator, so pollution and resource destruction go unchecked." },
  { id: "national-parks", title: "National Parks / Reserves", blurb: "Who preserves wilderness and reserves without government?" },
  { id: "natural-monopoly", title: "Natural Monopoly", blurb: "Courts, roads, and protection inherently consolidate into one provider anyway." },
  { id: "rights-enforcement-surplus", title: "Rights-Enforcement Surplus", blurb: "Private protection becomes a captive local monopoly that overcharges." },
  { id: "surplus-value", title: "Surplus Value", blurb: "Profit is just unpaid labor capitalists extract from workers — the core Marxist exploitation claim, built on the labor theory of value." },
  { id: "discrimination", title: "Discrimination", blurb: "Without civil rights law, businesses freely refuse service to groups.", tierTitleSize: 13 },
  { id: "lockean-proviso", title: "The Donut Proviso", blurb: "First-comers homestead everything; latecomers get no just claim to any resource." },
  { id: "humes-guillotine", title: "Hume's Guillotine", blurb: "You can't derive an “ought” (rights) from an “is” (self-ownership)." },
  { id: "subjectivism", title: "Subjectivism", blurb: "Property and value are subjective, so any homesteading rule is arbitrary." },
  { id: "intellectual-property", title: "Intellectual Property", blurb: "No patents or copyright without a state, so innovation is under-incentivized." },
  { id: "mercenaries", title: "Mercenaries", blurb: "Private defense firms are PMCs, and PMCs historically become armed factions." },
  { id: "positive-rights", title: "Positive Rights", blurb: "Rights to healthcare and education are as real as non-interference rights." },
  { id: "cap-to-state-drift", title: "Anarchist to State Drift", blurb: "Competing defense agencies coalesce into a dominant one, functionally recreating a state." },
  { id: "hobbesian-state-of-nature", title: "Hobbesian State of Nature", blurb: "Man is brutish; without a sovereign, life is a war of all against all." },
  { id: "survivalism", title: "Survivalism / Reification of the Zero", blurb: "NAP ethics is built around not dying, not a positive vision of flourishing." },
  { id: "borderarianism", title: "The Bordertarians", blurb: "Open borders plus a welfare state equals subsidized free-riding.", tierTitleSize: 13 },
  { id: "child-rights", title: "Child Rights", blurb: "Self-ownership and contract theory don't cleanly apply to children." },
  { id: "oligarchy", title: "Rich People Rule", blurb: "No elections or regulation, so capital owners run everything unaccountably." },
  { id: "epstein-scenario", title: "The Epstein Scenario", blurb: "Unregulated wealth could build private infrastructure for trafficking and blackmail with no oversight to stop it." },
  { id: "ancap-vs-state", title: "Crushed By The State", blurb: "A stateless ancap society just gets invaded and conquered by an organized collectivist state next door." },
]

// `label`/`grade` colours: top to bottom gold, butter, cream, bone, ink. `row`
// is the label tile, `zone` the (lighter) tile holding the cards, `card` the
// selected-card frame, `grade`/`name` the label text colours. Written out as
// full literal class strings so Tailwind's scanner sees them.
const TIERS = [
  {
    key: "made-me-think",
    grade: "S",
    label: "Actually Made Me Think",
    row: "tile-gold",
    zone: "tile-cream",
    gradeText: "text-ink",
    nameText: "text-ink",
  },
  {
    key: "edge-cases",
    grade: "A",
    label: "Fringe But Fun",
    row: "tile-butter",
    zone: "tile-bone",
    gradeText: "text-ink",
    nameText: "text-ink",
  },
  {
    key: "needs-explaining",
    grade: "B",
    label: "Quick Rebuttal",
    row: "tile-cream",
    zone: "tile-bone",
    gradeText: "text-ink",
    nameText: "text-ink",
  },
  {
    key: "stupidity-on-steroids",
    grade: "C",
    label: "Stupidity On Steroids",
    row: "tile-bone",
    zone: "tile-bone",
    gradeText: "text-ink",
    nameText: "text-ink",
  },
  {
    key: "couldnt-give-a-fuck",
    grade: "F",
    label: "Couldn't Give A Fuck",
    // Rendered with a censored asterisk, like the mockup; the owner's tier
    // name stays as-is in `label` (used for aria + the panel chip data).
    shown: "Couldn't Give A F*ck",
    row: "tile-ink",
    zone: "tile-ink",
    gradeText: "text-gold",
    nameText: "text-on-tile-ink",
  },
]

// Simon's final ranking — fixed, not user-editable. Order within each tier
// matters (it's deliberate), so render exactly this sequence rather than
// re-deriving it from ARGUMENTS' own (alphabetical-friendly) order.
const RANKING = {
  "made-me-think": ["child-rights"],
  "edge-cases": ["lockean-proviso", "voluntary-slavery", "borderarianism", "rights-enforcement-surplus", "subjectivism"],
  "needs-explaining": [
    "warlords-problem",
    "oligarchy",
    "profits-over-people",
    "mercenaries",
    "survivalism",
    "free-rider-problem",
  ],
  "stupidity-on-steroids": [
    "epstein-scenario",
    "public-utilities",
    "intellectual-property",
    "might-makes-right",
    "natural-monopoly",
    "discrimination",
    "humes-guillotine",
    "surplus-value",
  ],
  "couldnt-give-a-fuck": [
    "poor-people",
    "never-been-tried",
    "moral-degeneracy",
    "national-parks",
    "environment",
    "hobbesian-state-of-nature",
    "positive-rights",
    "ancap-vs-state",
    "cap-to-state-drift",
    "roads",
  ],
}

const byId = Object.fromEntries(ARGUMENTS.map((a) => [a.id, a]))

// Side-panel write-ups (site/tier-list-content/<id>.md) — pre-rendered here
// at build time and swapped in/out client-side by id, rather than fetched +
// parsed in the browser. Reuses the same content-collection/render()
// pipeline as essays, so [[Wikilink]] resolution (remarkVaultLinks) works
// identically inside these write-ups.
const tierListContentEntries = await getCollection("tierListContent")
const renderedById: Record<string, Awaited<ReturnType<typeof render>>["Content"]> = {}
for (const entry of tierListContentEntries) {
  const { Content } = await render(entry)
  renderedById[entry.id] = Content
}

// Art extension is resolved at build time (not probed in the browser) since
// this page is now a fixed, non-interactive final ranking — every id in
// RANKING is expected to have a file here.
// Resolved against process.cwd() (always `site/`, since every npm script
// here runs from that directory) rather than import.meta.url — Astro
// bundles this frontmatter into a build chunk elsewhere, so "this file's
// own location" isn't a stable thing to resolve a relative path against.
const ART_SRC_DIR = path.resolve(process.cwd(), "tier-list-art-src")
const artExtById = Object.fromEntries(
  fs.readdirSync(ART_SRC_DIR).map((filename) => [path.parse(filename).name, path.parse(filename).ext]),
)

const tierByArg = Object.fromEntries(
  TIERS.flatMap((tier) => RANKING[tier.key].map((id) => [id, tier])),
)
const totalArguments = Object.values(RANKING).reduce((n, ids) => n + ids.length, 0)

---

<Layout
  title="Arguments Against AnCap: Tier List"
  description="The definitive ranking of arguments against anarcho-capitalism, from Hume's Guillotine down to Couldn't Give A Fuck."
>
  <div id="tier-page-content" class="tier-page-content @container">
    <section class="flex flex-col gap-6 pt-10 pb-6 sm:pt-14 @4xl:flex-row @4xl:items-end @4xl:justify-between @4xl:gap-8 xl:pt-20 xl:pb-8">
      <div class="flex flex-col gap-4">
        <p class="mono-label m-0 !text-[0.75rem] sm:!text-[0.8125rem] !tracking-[0.14em]">
          {totalArguments} Arguments · Ranked by how much they actually land
        </p>
        <h1 class="display-xl m-0 max-sm:!text-[clamp(1.75rem,10vw,3.5rem)] xl:!text-[5.5rem] xl:!leading-[0.95]">
          Arguments<br />against ancap.
        </h1>
      </div>
      <p class="m-0 max-w-[22.5rem] text-base leading-[1.7] text-char @4xl:shrink-0 @4xl:text-right">
        Tap any card for the claim and the rebuttal. The ranking is fixed; argue with it in the essays.
      </p>
    </section>

    <div id="tier-grid" class="@container flex flex-col gap-2.5">
      {
        TIERS.map((tier) => (
          <div class="flex flex-col gap-2.5 @2xl:flex-row">
            <div
              class={`${tier.row} flex flex-row items-center gap-4 rounded-[24px] px-5 py-4 @2xl:w-[200px] @2xl:shrink-0 @2xl:flex-col @2xl:items-stretch @2xl:justify-between @2xl:gap-4 @2xl:p-5`}
            >
              <div class={`display-xl !text-[2.75rem] !leading-[1] ${tier.gradeText}`} aria-hidden="true">
                {tier.grade}
              </div>
              <h2
                class={`m-0 font-display text-[0.9375rem] leading-[1.15] font-black uppercase [font-stretch:112%] [font-variation-settings:'wdth'_112] ${tier.nameText}`}
                aria-label={`${tier.grade} tier: ${tier.label}`}
              >
                {tier.shown ?? tier.label}
              </h2>
            </div>
            <div
              class={`${tier.zone} flex min-h-[8rem] flex-1 flex-wrap content-start gap-2 rounded-[24px] p-3 @2xl:p-3.5`}
            >
              {
                RANKING[tier.key].map((id) => {
                  const arg = byId[id]
                  const ext = artExtById[id]
                  return (
                    <div
                      class={`group flex w-[calc((100%-1rem)/3)] shrink-0 @md:w-28 cursor-pointer flex-col gap-2 rounded-[22px] p-1 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 ${tier.key === "couldnt-give-a-fuck" ? "text-on-tile-ink hover:bg-white/10 focus-visible:outline-gold aria-expanded:!bg-gold aria-expanded:!text-[#0f0e0c]" : "text-ink hover:bg-ink/10 focus-visible:outline-ink aria-expanded:!bg-tile-ink aria-expanded:!text-gold"}`}
                      role="button"
                      tabindex="0"
                      data-arg-id={id}
                      aria-expanded="false"
                      aria-controls="tier-panel"
                      aria-label={`${arg.title}: ${arg.blurb}`}
                    >
                      <div class="aspect-square w-full overflow-hidden rounded-[18px] bg-parchment">
                        {ext && (
                          <img class="h-full w-full object-cover" loading="lazy" alt="" src={`/tier-list-art/${id}${ext}`} />
                        )}
                      </div>
                      <div
                        class="px-1 pb-1 text-[0.8125rem] leading-[1.2] font-bold break-words text-inherit [-webkit-hyphens:none] [hyphens:none]"
                        lang="en"
                      >
                        {arg.title}
                      </div>
                    </div>
                  )
                })
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <aside id="tier-panel" class="tier-panel" data-open="false" aria-hidden="true" aria-label="Argument write-up">
    <div class="tier-panel-inner">
      <div class="sticky top-0 z-10 h-0">
        <button
          id="tier-panel-close"
          type="button"
          class="btn-circle absolute top-4 right-4 !h-11 !w-11 !border-0 !bg-white !text-[#0f0e0c] hover:!bg-white hover:opacity-85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f0e0c]"
          aria-label="Close panel"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2.4" />
          </svg>
        </button>
      </div>
      {
        ARGUMENTS.map((arg) => {
          const Content = renderedById[arg.id]
          const ext = artExtById[arg.id]
          const tier = tierByArg[arg.id]
          return (
            <div class="tier-panel-entry" data-panel-id={arg.id} hidden>
              <div class="relative aspect-[18/13] w-full bg-[#fff4cc]">
                {ext && (
                  <img
                    class="h-full w-full object-cover mix-blend-multiply"
                    alt=""
                    src={`/tier-list-art/${arg.id}${ext}`}
                  />
                )}
              </div>
              <div class="flex flex-col gap-4 p-6 sm:p-7">
                <div>
                  <span class="inline-flex h-[1.875rem] items-center rounded-full bg-[#0f0e0c] px-3 font-mono text-[0.6875rem] font-bold tracking-[0.08em] text-gold uppercase">
                    {tier.grade} · {tier.shown ?? tier.label}
                  </span>
                </div>
                <h2 class="display-xl m-0 !text-[clamp(1.75rem,1.2rem+1.6vw,2.25rem)] !leading-[1.02] !tracking-[-0.025em] break-words">
                  {arg.title}
                </h2>
                {Content ? (
                  <div class="prose-body">
                    <Content />
                  </div>
                ) : (
                  <p class="m-0 text-sm text-ink">No write-up yet for this one.</p>
                )}
              </div>
            </div>
          )
        })
      }
    </div>
  </aside>

  <script>
    // The sidebar is `position: fixed`, so it needs the header's real
    // rendered height (not a guessed rem value) to sit below it rather than
    // covering it — the header isn't itself fixed/sticky, so its height is
    // measured, not assumed.
    const header = document.querySelector("body > header")
    const setHeaderHeightVar = () => {
      if (!(header instanceof HTMLElement)) return
      document.documentElement.style.setProperty("--header-h", `${header.getBoundingClientRect().height}px`)
    }
    setHeaderHeightVar()
    window.addEventListener("resize", setHeaderHeightVar)

    const grid = document.getElementById("tier-grid")
    const panel = document.getElementById("tier-panel")
    const closeBtn = document.getElementById("tier-panel-close")
    const content = document.getElementById("tier-page-content")

    if (grid && panel && closeBtn && content) {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-arg-id]"))
      const entries = Array.from(panel.querySelectorAll<HTMLElement>("[data-panel-id]"))
      let lastCard: HTMLElement | null = null

      const openPanel = (id: string) => {
        const card = cards.find((c) => c.dataset.argId === id)
        if (!card) return
        lastCard = card
        entries.forEach((entry) => {
          entry.hidden = entry.dataset.panelId !== id
        })
        panel.dataset.open = "true"
        panel.setAttribute("aria-hidden", "false")
        content.dataset.panelOpen = "true"
        document.body.dataset.tierPanelOpen = "true"
        cards.forEach((c) => c.setAttribute("aria-expanded", String(c === card)))
      }

      const closePanel = () => {
        // aria-hidden can't sit on an element that still contains focus (the
        // close button, if that's what triggered the close) — move focus
        // back to the card that opened the panel first.
        const active = document.activeElement
        if (active instanceof HTMLElement && panel.contains(active)) {
          if (lastCard) lastCard.focus()
          else active.blur()
        }
        panel.dataset.open = "false"
        panel.setAttribute("aria-hidden", "true")
        content.dataset.panelOpen = "false"
        document.body.dataset.tierPanelOpen = "false"
        cards.forEach((c) => c.setAttribute("aria-expanded", "false"))
      }

      grid.addEventListener("click", (event) => {
        const target = event.target
        const card = target instanceof Element ? target.closest("[data-arg-id]") : null
        if (card instanceof HTMLElement && card.dataset.argId) openPanel(card.dataset.argId)
      })

      grid.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return
        const target = event.target
        const card = target instanceof Element ? target.closest("[data-arg-id]") : null
        if (!(card instanceof HTMLElement) || !card.dataset.argId) return
        event.preventDefault()
        openPanel(card.dataset.argId)
      })

      closeBtn.addEventListener("click", closePanel)

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && panel.dataset.open === "true") closePanel()
      })
    }
  </script>
</Layout>
